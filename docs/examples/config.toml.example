# Example configuration file for `stt-server`.
#
# Load with:
#     stt-server --config /path/to/this.toml
#
# When no `--config` is given, the server layers two files (the
# XDG-user one wins over the system one):
#     /etc/nagent/config.toml
#     $XDG_CONFIG_HOME/nagent/config.toml
#     (or $HOME/.config/nagent/config.toml when XDG_CONFIG_HOME is unset)
# Missing files are silently skipped.
#
# Precedence (highest wins):
#   1. Environment variable (or `.env` value, same precedence).
#   2. The TOML file(s) above, layered later-overrides-earlier.
#   3. Hardcoded default baked into the binary.
#
# All keys are optional; unknown keys / sub-tables are rejected at load
# time (`deny_unknown_fields`) so a typo never silently reverts to a
# default.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# [server]
# bind_addr = "0.0.0.0:8080"
# whisper_model_path = "/models/ggml-base.bin"   # required (env or TOML)
# max_queue = 32
# session_idle_timeout_ms = 30_000
# infer_timeout_ms = 30_000

# ---------------------------------------------------------------------------
# WebSocket frame limits
# ---------------------------------------------------------------------------

# [server.limits]
# max_audio_frame_samples = 480_000        # 30 s × 16 kHz Float32
# required_sample_rate = 16_000
# max_language_hint_bytes = 16

# ---------------------------------------------------------------------------
# Per-source-IP rate limits
# ---------------------------------------------------------------------------

# [server.rate_limits]
# stt_per_min = 120
# llm_per_min = 30

# ---------------------------------------------------------------------------
# LLM proxy (Ollama or any OpenAI-compatible upstream)
# ---------------------------------------------------------------------------

# [llm]
# enabled = false
# base_url = "http://localhost:11434"
# default_model = "llama3.1"
# api_key = ""                              # optional bearer token
# request_timeout_secs = 120
# cors_allow_origins = []                   # empty = same-origin only
# system_prompt = "You are a strict, concise assistant."   # mirrors LLM_SYSTEM_PROMPT
# allow_user_location = true                      # mirrors LLM_ALLOW_USER_LOCATION; strip the browser-injected location block when false
# allow_user_timezone = true                      # mirrors LLM_ALLOW_USER_TIMEZONE; strip the browser-injected timezone block when false (independent of allow_user_location)

# ---------------------------------------------------------------------------
# Chat agents — master switches + one sub-table per tool
# ---------------------------------------------------------------------------

# [agents]
# enabled = true
# llm_max_tool_rounds = 4                   # hard cap, defended against loops

# `web_fetch` agent — sandbox + transfer knobs
# [agents.web_fetch]
# allow_public = false                      # public IPs blocked by default
# allowlist = ["*.wikipedia.org", "example.com"]
# max_bytes = 2_097_152                     # 2 MiB hard cap
# timeout_ms = 30_000

# `get_weather` agent — WeatherAPI.com credentials
# Register for a free key at https://www.weatherapi.com/
# [agents.get_weather]
# api_key = "your-weatherapi-key"
# timeout_ms = 8_000
# base_url = "https://api.weatherapi.com"

# `unit_convert` agent — pure-local unit conversions (length, mass,
# volume, time, data, speed, area, temperature). No API key.
# [agents.unit_convert]
# timeout_ms = 5_000

# `wikipedia` agent — anonymous REST access to Wikipedia summaries.
# No API key; Wikimedia only requires a descriptive `User-Agent`.
# Customise the contact string if you operate a high-volume deployment.
# [agents.wikipedia]
# timeout_ms = 5_000
# base_url = "https://en.wikipedia.org/api/rest_v1"
# user_agent = "nagent-wikipedia-agent/0.1 (contact: ops@example.com)"

# `dictionary` agent — Free Dictionary API (no API key). Returns
# definitions, phonetics, examples, and synonyms for an English word.
# [agents.dictionary]
# timeout_ms = 5_000
# base_url = "https://api.dictionaryapi.dev/api/v2"

# ---------------------------------------------------------------------------
# Text-to-speech (Piper ONNX, local)
# ---------------------------------------------------------------------------
# All voices are CC-BY-NC-SA — see README "Text-to-Speech (Piper)" section
# for attribution. Download voices with scripts/download-piper-voices.sh.
#
# The model_dir must contain one <voice>.onnx + <voice>.onnx.json pair per
# voice. When `enabled = false` the /v1/audio/* routes are not registered and
# the discussion-mode "Read response aloud" UI shows no checkbox.
#
# [tts]
# enabled = false
# model_dir = "./models/piper"
# voice_en = "en_US-lessac-medium"            # English voice id
# voice_fr = "fr_FR-upmc-medium"              # French voice id
# default_lang = "en"                          # "en" or "fr" (used when the request omits a lang)
# length_scale = 1.0                           # >1.0 = slower, <1.0 = faster (overridable per request)
# noise_scale = 0.667                          # Piper upstream default; controls variability
# noise_w = 0.8                                # Piper upstream default; controls phoneme variability
# max_input_chars = 2000                       # hard cap per /v1/audio/speech request body

# ---------------------------------------------------------------------------
# Authentication & user identity (PR1)
# ---------------------------------------------------------------------------
# When `enabled = false` (the default) the server keeps the pre-PR1 single 
# user trust boundary:
# no login routes, no /api/me, no RequireAuth layer. Turning this on
# REQUIRES [auth.db] to point at a reachable SQL store (sqlite or postgres);
# the server refuses to boot otherwise. See README "Authentication" for
# the bootstrap walkthrough — on a fresh sqlite install the server
# auto-creates the first local admin and logs the random password at
# WARN level.
#
# [auth]
# enabled = false
# backends = ["local"]                       # subset of: local, oidc, passkey (multiple allowed)
# public_url = "https://nagent.example.com"  # scheme + host (no trailing slash); drives cookie Secure flag
# session_ttl_days = 7                       # absolute TTL, NOT sliding; range 1..=90
# csrf_header = "x-csrf-token"
#
# [auth.db]
# backend = "sqlite"                         # "sqlite" | "postgres"
# url = "sqlite://./data/auth.db?mode=rwc"   # sqlite path or postgres:// URL
# max_connections = 16
#
# [auth.password]
# argon2_memory_kib = 19456                  # OWASP 2025 minimum; clamped to this value
# argon2_iterations = 2
# argon2_parallelism = 1
# min_password_length = 8
# allow_registration = true                  # logged-in users can create accounts
#
# [auth.oidc]
# auto_provision = true                       # create users row on first OIDC login
# issuer = "https://keycloak.example.com/realms/nagent"
# client_id = "nagent"
# client_secret = ""                         # env: NAGENT_AUTH_OIDC_CLIENT_SECRET (avoid TOML for secrets)
# scopes = ["openid", "email", "profile"]
# required_groups = []                        # IdP group allow-list; empty = no restriction
# role_claim = "groups"
#
# [auth.passkey]
# self_registration = true                    # any logged-in user can enrol a passkey
# rp_id = "nagent.example.com"                # MUST match the browser's effective domain (no scheme, no port)
# rp_name = "nagent"
# origins = ["https://nagent.example.com"]    # scheme + port; first entry must match public_url's origin

# ---------------------------------------------------------------------------
# Per-user credentials vault (framework)
# ---------------------------------------------------------------------------
# Plaintext credentials are encrypted at rest with AES-256-GCM. The
# encryption key lives in plaintext inside `[auth.credentials].key`
# (64 hex chars / 32 bytes). The server refuses to boot when
# auth.enabled is true AND at least one agent is registered AND the
# key is missing or malformed. Treat this file as a secret
# (encrypted volume, restricted ACLs, no VCS). The v1 framework
# ships with an empty ServiceRegistry (no concrete integrations);
# follow-up PRs add per-service entries.
#
# [auth.credentials]
# key = "0123…64 hex chars, generate with `openssl rand -hex 32`…"

# ---------------------------------------------------------------------------
# Document uploads (Discussion-mode)
# ---------------------------------------------------------------------------
# Lets the user upload `.txt` and `.pdf` files via the sidebar
# Documents panel. The LLM picks which document to consult via the
# `read_document` tool (scoped to the chat session id). The
# documents module is always compiled in (pdf-extract +
# mime_guess are unconditional deps). Requires `auth.enabled =
# true` (the table lives in the auth DB). The cache dir must be
# writable at boot — the kustomize base mounts a PVC at
# `/var/cache/nagent/docs`.
#
# [documents]
# enabled = false
# cache_dir = "/var/cache/nagent/docs"     # PVC mount in k8s; ignored when enabled = false
# max_file_size_bytes = 20_971_520         # 20 MiB hard cap
# max_extracted_chars = 100_000            # per-call text return cap; past the cap a `[… truncated …]` marker is added
# max_docs_per_session = 50                # per-session quota; the 51st upload is rejected
# pdf_extract_timeout_secs = 30            # wraps the synchronous pdf-extract call
# purge_interval_hours = 24                # background sweep cadence; set to 0 to disable
# default_ttl_days = 30                    # rows + files older than this are purged
# [auth.credentials]
# key = "0123…64 hex chars, generate with `openssl rand -hex 32`…"

